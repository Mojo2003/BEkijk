<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android TV & D-pad compatibiliteit -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Verplicht op Android 11+ om geinstalleerde Belgische TV-apps te openen -->
    <queries>
        <package android:name="be.vrt.vrtnu" />
        <package android:name="be.vmma.vtm.zenderapp" />
        <package android:name="be.goplay.app" />
        <package android:name="be.rtbf.auvio" />
        <package android:name="com.tapptic.rtl.tvi" />
        <package android:name="tv.arte.plus7" />
        <package android:name="nl.uitzendinggemist" />
    </queries>

    <application
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.BEkijk">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
